<style>
  :root {
    --bg: #1a1611;
    --surface: #211c16;
    --surface-2: #2a241b;
    --accent: #d4825a;
    --accent-soft: rgba(212, 130, 90, 0.15);
    --text: #f5f0e8;
    --text-2: #b8ada0;
