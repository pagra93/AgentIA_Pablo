#!/usr/bin/env bash
# {{PACKAGE_NAME}} — Installer
#
# Compila e instala los agentes y comandos de este paquete a ~/.claude/.
#
# Que hace:
# 1. Compila cada agente del paquete (agent.yaml + SOUL.md + DUTIES.md) en un .md unico
# 2. Copia comandos del paquete a ~/.claude/commands/
# 3. NO toca skills/rules/knowledge genericos (asume que el arquitecto ya los instalo)
# 4. Anade el paquete a ~/.claude/packages-registry.txt
#
# Idempotente: ejecutar dos veces no rompe nada.
#
# Usage:
#   chmod +x install.sh
#   ./install.sh
#
# Despues de instalar, los comandos /{{PREFIX}}-* y los agentes age-*-{{PREFIX}}-*
# estaran disponibles globalmente en Claude Code.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="$HOME/.claude"
PACKAGE_NAME="{{PACKAGE_NAME}}"
PREFIX="{{PREFIX}}"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m'

echo ""
echo -e "${GREEN}${PACKAGE_NAME} — Installer${NC}"
echo "================================"
echo "Source:  $SCRIPT_DIR"
echo "Target:  $TARGET_DIR"
echo "Prefix:  $PREFIX"
echo ""

# Validacion: ~/.claude/ debe existir (creado por install.sh del arquitecto o PM x10)
if [ ! -d "$TARGET_DIR" ]; then
    echo -e "${RED}Error:${NC} $TARGET_DIR no existe."
    echo "Instala primero el arquitecto o PM x10 para crear la estructura base de ~/.claude/."
    exit 1
fi

# --- Safe write function ---
safe_write() {
    local dest="$1"
    local content="$2"

    if [ -f "$dest" ]; then
        if echo "$content" | diff -q - "$dest" > /dev/null 2>&1; then
            echo -e "  ${GREEN}[identical]${NC} $(basename "$dest")"
            return 0
        fi
        echo -e "  ${YELLOW}[exists]${NC} $(basename "$dest")"
        read -p "    Overwrite? (y/N): " choice
        case "$choice" in
            y|Y)
                echo "$content" > "$dest"
                echo -e "    ${GREEN}[updated]${NC}"
                ;;
            *)
                echo -e "    ${YELLOW}[skipped]${NC}"
                ;;
        esac
    else
        echo "$content" > "$dest"
        echo -e "  ${GREEN}[installed]${NC} $(basename "$dest")"
    fi
}

safe_copy() {
    local src="$1"
    local dest="$2"

    if [ -f "$dest" ]; then
        if diff -q "$src" "$dest" > /dev/null 2>&1; then
            echo -e "  ${GREEN}[identical]${NC} $(basename "$dest")"
            return 0
        fi
        echo -e "  ${YELLOW}[exists]${NC} $(basename "$dest")"
        read -p "    Overwrite? (y/N): " choice
        case "$choice" in
            y|Y)
                cp "$src" "$dest"
                echo -e "    ${GREEN}[updated]${NC}"
                ;;
            *)
                echo -e "    ${YELLOW}[skipped]${NC}"
                ;;
        esac
    else
        cp "$src" "$dest"
        echo -e "  ${GREEN}[installed]${NC} $(basename "$dest")"
    fi
}

# --- Create target directories (si no existen) ---
mkdir -p "$TARGET_DIR/agents"
mkdir -p "$TARGET_DIR/commands"

# ============================================
# 1. COMPILE AGENTS DEL PAQUETE
# ============================================
echo -e "${CYAN}Compiling agents del paquete...${NC}"

for agent_dir in "$SCRIPT_DIR/agents"/*/; do
    if [ -d "$agent_dir" ]; then
        agent_name=$(basename "$agent_dir")
        agent_yaml="$agent_dir/agent.yaml"
        soul_md="$agent_dir/SOUL.md"
        duties_md="$agent_dir/DUTIES.md"

        compiled=""

        if [ -f "$agent_yaml" ]; then
            name=$(grep '^name:' "$agent_yaml" | head -1 | sed 's/name: *//')
            desc=$(grep '^description:' "$agent_yaml" | head -1 | sed 's/description: *//' | tr -d '"')
            model=$(grep 'preferred:' "$agent_yaml" | head -1 | sed 's/.*preferred: *//')
            tools=$(grep '^tools:' "$agent_yaml" | head -1 | sed 's/tools: *//')

            compiled="---
name: $name
description: $desc
model: $model
tools: $tools
---
"
        fi

        if [ -f "$soul_md" ]; then
            compiled="$compiled
$(cat "$soul_md")
"
        fi

        if [ -f "$duties_md" ]; then
            compiled="$compiled

---

$(cat "$duties_md")
"
        fi

        # Inline preloaded skills (busca en skills/, rules/, knowledge/ del paquete o del arquitecto)
        if [ -f "$agent_yaml" ]; then
            skills_list=$(awk '
                /^skills:/ { in_skills=1; next }
                in_skills && /^[a-zA-Z]/ { in_skills=0 }
                in_skills && /^[[:space:]]*-[[:space:]]+/ {
                    sub(/^[[:space:]]*-[[:space:]]+/, "")
                    sub(/[[:space:]]*#.*$/, "")
                    print
                }
            ' "$agent_yaml")

            for skill_name in $skills_list; do
                skill_content=""
                skill_source=""
                # Buscar primero en el paquete
                if [ -f "$SCRIPT_DIR/skills/$skill_name/SKILL.md" ]; then
                    skill_source="skills/$skill_name/SKILL.md"
                    skill_content=$(cat "$SCRIPT_DIR/skills/$skill_name/SKILL.md")
                elif [ -f "$SCRIPT_DIR/rules/$skill_name.md" ]; then
                    skill_source="rules/$skill_name.md"
                    skill_content=$(cat "$SCRIPT_DIR/rules/$skill_name.md")
                elif [ -f "$SCRIPT_DIR/knowledge/$skill_name.md" ]; then
                    skill_source="knowledge/$skill_name.md"
                    skill_content=$(cat "$SCRIPT_DIR/knowledge/$skill_name.md")
                # Si no, asumir que esta instalada globalmente desde el arquitecto
                elif [ -f "$TARGET_DIR/skills/$skill_name/SKILL.md" ]; then
                    skill_source="(global) skills/$skill_name/SKILL.md"
                    skill_content=$(cat "$TARGET_DIR/skills/$skill_name/SKILL.md")
                fi

                if [ -n "$skill_content" ]; then
                    compiled="$compiled

---

# Preloaded Skill: $skill_name
<!-- source: $skill_source -->

$skill_content
"
                else
                    echo -e "  ${YELLOW}[warn]${NC} Skill '$skill_name' no encontrada (ni local ni global). Agente '$agent_name' la referencia pero seguira sin esa skill precargada."
                fi
            done
        fi

        dest_file="$TARGET_DIR/agents/$agent_name.md"
        safe_write "$dest_file" "$compiled"
    fi
done
echo ""

# ============================================
# 2. COPY COMMANDS DEL PAQUETE
# ============================================
echo -e "${CYAN}Installing comandos del paquete...${NC}"
for cmd_file in "$SCRIPT_DIR/commands"/*.md; do
    if [ -f "$cmd_file" ]; then
        safe_copy "$cmd_file" "$TARGET_DIR/commands/$(basename "$cmd_file")"
    fi
done
echo ""

# ============================================
# 3. INSTALL SKILLS/RULES/KNOWLEDGE ESPECIFICOS DEL PAQUETE
# ============================================
# (Los genericos no se tocan: ya estan instalados por el arquitecto o PM x10.)
# Solo instalamos los que sean exclusivos del paquete (si los hay).
mkdir -p "$TARGET_DIR/skills"
echo -e "${CYAN}Installing skills/rules/knowledge especificos del paquete...${NC}"
for skill_dir in "$SCRIPT_DIR/skills"/*/; do
    if [ -d "$skill_dir" ]; then
        skill_name=$(basename "$skill_dir")
        # Solo instalar si tiene prefix del paquete (especificos), no los genericos
        if [[ "$skill_name" == *"-${PREFIX}-"* ]] || [[ "$skill_name" == "${PREFIX}-"* ]]; then
            mkdir -p "$TARGET_DIR/skills/$skill_name"
            for item in "$skill_dir"*; do
                if [ -f "$item" ]; then
                    safe_copy "$item" "$TARGET_DIR/skills/$skill_name/$(basename "$item")"
                fi
            done
        fi
    fi
done
# Mismo para rules y knowledge especificos del paquete
for rule_file in "$SCRIPT_DIR/rules"/rul-${PREFIX}-*.md 2>/dev/null; do
    if [ -f "$rule_file" ]; then
        rule_name=$(basename "$rule_file" .md)
        rule_dest="$TARGET_DIR/skills/$rule_name"
        mkdir -p "$rule_dest"
        safe_copy "$rule_file" "$rule_dest/SKILL.md"
    fi
done
for kno_file in "$SCRIPT_DIR/knowledge"/kno-${PREFIX}-*.md 2>/dev/null; do
    if [ -f "$kno_file" ]; then
        kno_name=$(basename "$kno_file" .md)
        kno_dest="$TARGET_DIR/skills/$kno_name"
        mkdir -p "$kno_dest"
        safe_copy "$kno_file" "$kno_dest/SKILL.md"
    fi
done
echo ""

# ============================================
# 4. REGISTRAR PAQUETE
# ============================================
REGISTRY="$TARGET_DIR/packages-registry.txt"
if ! grep -q "^${PACKAGE_NAME}|" "$REGISTRY" 2>/dev/null; then
    echo "${PACKAGE_NAME}|${PREFIX}|${SCRIPT_DIR}|$(date -u +%Y-%m-%dT%H:%M:%S%z)" >> "$REGISTRY"
    echo -e "${CYAN}Registrado en ${REGISTRY}${NC}"
fi
echo ""

# ============================================
# SUMMARY
# ============================================
echo "================================"
echo -e "${GREEN}Installation complete!${NC}"
echo ""
agent_count=$(ls "$TARGET_DIR/agents"/*.md 2>/dev/null | grep -c "${PREFIX}-\|age-sup-" || true)
cmd_count=$(ls "$TARGET_DIR/commands"/*.md 2>/dev/null | grep -c "^.*$" || true)
echo "Agentes del paquete instalados a ~/.claude/agents/ (con prefix ${PREFIX} o supervisores QA)"
echo "Comandos del paquete instalados a ~/.claude/commands/"
echo ""
echo -e "${CYAN}Proximos pasos:${NC}"
echo "  1. Abrir Claude Code en cualquier proyecto"
echo "  2. Probar /${PREFIX}-<comando> (autocompletado mostrara los disponibles)"
echo "  3. Para desplegar este paquete en un proyecto cliente:"
echo "     bash ${SCRIPT_DIR}/deploy.sh /ruta/al/proyecto-cliente"
echo ""
